    {
      "parameters": {
        "promptType": "define",
        "text": "=LEAD\nName: {{ $json.name }}\nTitle: {{ $json.title }}\nCompany: {{ $json.company }}\nEmail domain: {{ $json.email_domain }}",
        "options": {
          "systemMessage": "You are an expert Sales Operations and GTM research agent.\n\nYOUR JOB\n1. Use the TavilySearch tool AT MOST ONCE to research the lead's company: what it does, its industry and its approximate employee count. Pass a short plain-text query such as \"<company> company overview industry employees\".\n2. Evaluate ICP fit as exactly one of: High, Medium, Low, Unknown.\n3. Draft a personalized 2-sentence outreach opener addressed to the lead's first name.\n\nICP DEFINITION (edit this section for your business)\n- B2B companies, ideally software or technology\n- Roughly 50-1000 employees\n- The lead's job title suggests responsibility for sales, revenue, marketing or operations\n\nRULES\n- Never invent facts. If the company is missing, unknown, or the search finds nothing reliable, set icp_fit to \"Unknown\" and explain briefly in icp_reasoning.\n- If the email is from a free provider (gmail.com, outlook.com, gmx.de, etc.) and no company is given, do not search. Use \"Unknown\".\n- Never call the tool more than once.\n\nOUTPUT FORMAT\nReturn ONLY a valid JSON object. No markdown, no code fences, no text before or after. Use exactly these keys:\n{\"company_summary\": \"...\", \"industry\": \"...\", \"employee_range\": \"...\", \"icp_fit\": \"High|Medium|Low|Unknown\", \"icp_reasoning\": \"...\", \"outreach_message\": \"...\"}",
          "maxIterations": 3
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        720,
        400
      ],
      "id": "ef8bbd60-0424-5b60-9f02-98423d853307",
      "name": "GTM AI Agent",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        700,
        640
      ],
      "id": "bfd0fc10-4ae5-5c6e-9051-b11c329e4bff",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "REPLACE_ME",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Search the web for company information. Provide a concise plain-text search query, e.g. \"Acme Corp industry employee count funding\".",
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            {
              "name": "query",
              "value": "{query}"
            },
            {
              "name": "search_depth",
              "value": "basic"
            },
            {
              "name": "max_results",
              "value": "2"
            },
            {
              "name": "include_answer",
              "value": "true"
            }
          ]
        },
        "placeholderDefinitions": {
          "values": [
            {
              "name": "query",
              "description": "The web search query about the company, e.g. \"Acme Corp industry employee count funding\"",
              "type": "string"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [
        860,
        640
      ],
      "id": "f085cb28-1a48-554c-88a3-d98c2831631a",
      "name": "TavilySearch",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Tavily Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Lead Data').first().json;\nlet raw = $input.first().json.output;\nif (raw === undefined || raw === null) raw = '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\nraw = raw.replace(/```json|```/gi, '').trim();\n\nlet parsed = {};\nlet parseError = false;\ntry {\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  parsed = JSON.parse(raw.slice(start, end + 1));\n} catch (e) {\n  parseError = true;\n}\n\nconst fits = ['High', 'Medium', 'Low', 'Unknown'];\nconst fitRaw = String(parsed.icp_fit || 'Unknown').trim();\nconst icpFit = fits.find(f => f.toLowerCase() === fitRaw.toLowerCase()) || 'Unknown';\nconst clean = (v, max) => String(v === undefined || v === null ? '' : v).slice(0, max);\n\nconst result = {\n  ...lead,\n  company_summary: clean(parsed.company_summary, 1000),\n  industry: clean(parsed.industry, 200),\n  employee_range: clean(parsed.employee_range, 100),\n  icp_fit: icpFit,\n  icp_reasoning: clean(parsed.icp_reasoning, 1000),\n  outreach_message: clean(parsed.outreach_message, 1000),\n  parse_error: parseError,\n};\n\nconst icon = { High: '🟢', Medium: '🟡', Low: '🔴', Unknown: '⚪' }[icpFit];\nconst lines = [\n  `${icon} New lead: ${lead.name || 'n/a'} (${lead.title || 'no title'}) at ${lead.company || 'no company'}`,\n  `ICP fit: ${icpFit} | Industry: ${result.industry || 'n/a'} | Size: ${result.employee_range || 'n/a'}`,\n  `Why: ${result.icp_reasoning || 'n/a'}`,\n  `Draft opener: ${result.outreach_message || 'n/a'}`,\n];\nif (parseError) lines.push('⚠️ The AI output could not be parsed. Check the execution.');\nresult.notification_text = lines.join('\\n');\n\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        400
      ],
      "id": "06444eb3-6eec-5431-a223-f32b6d0d7e18",
      "name": "Parse AI Output"
    },
